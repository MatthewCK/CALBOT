# Copy this file to .env and fill it in. On Railway, add these as service variables instead.
# Everything is optional except where to send alerts.

# --- Who to follow ---
# MLB player and team IDs. Defaults: Cal Raleigh and the Seattle Mariners.
# Player ID: the number at the end of the player's mlb.com URL, e.g. mlb.com/player/cal-raleigh-663728
# Team ID: see the table in the README, or https://statsapi.mlb.com/api/v1/teams?sportId=1
PLAYER_ID=663728
TEAM_ID=136
# Short name used in messages ("CAL DINGER!", "Cal is on deck")
PLAYER_NAME=Cal
# IANA time zone for game times in messages, e.g. America/New_York, America/Chicago
TIMEZONE=America/Los_Angeles

# --- Where to send alerts (set one or both) ---
# WhatsApp group chat ID. Leave blank on first run, send a message in the group,
# and copy the ID from the logs ("Message in group chat 120...@g.us").
GROUP_CHAT_ID=
# Individual phone numbers: comma-separated, country code, no + or spaces
RECIPIENT_NUMBERS=

# --- Chat command ---
# Anyone in the chat can send this to check the bot is up and get game info
COMMAND=!cal

# --- Optional home run wager ---
# Each person's picks for the player's final regular-season home run total.
# Format: Name:pick,pick,...;Name:pick,...   Leave blank to turn the wager off.
WAGER_PICKS=Tim:54,55,56,60;Austin:53,57,58,59;Matt:61,62,63,64

# --- Running the service ---
# Required to use the POST /test-whatsapp endpoint. Use a long random string.
ADMIN_TOKEN=
# Folder for the WhatsApp login and the list of sent alerts. On Railway, point this
# at a volume (e.g. /data) so redeploys don't log WhatsApp out.
DATA_DIR=.
# How often to check the live game, in milliseconds
POLL_INTERVAL_MS=15000
PORT=3000
