{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "calbot/latest.schema.json",
  "title": "latest.json",
  "description": "Pointer to the newest model run. Written last when publishing.",
  "type": "object",
  "required": ["schema", "run_id", "last_event_id", "model_version", "updated_at"],
  "properties": {
    "schema": { "const": 1 },
    "run_id": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}Z$" },
    "last_event_id": { "type": "integer", "minimum": 0 },
    "model_version": { "type": "string" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
